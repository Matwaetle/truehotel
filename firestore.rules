rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /hotels/{hotelId} {
      allow read: if true;
      allow write: if false;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if owns(request.resource.data.uid);
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow read: if true;
      allow create, update: if owns(uid) && request.resource.data.uid == uid;
      allow delete: if false;
    }

    match /trusts/{trustId} {
      allow read: if true;
      allow create: if owns(request.resource.data.fromUid)
        && request.resource.data.toUid is string
        && request.resource.data.fromUid != request.resource.data.toUid
        && trustId == request.resource.data.fromUid + '_' + request.resource.data.toUid;
      allow update: if false;
      allow delete: if owns(resource.data.fromUid);
    }

    match /orders/{orderId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
